{
  "name": "tianshu-canvas",
  "version": "0.7.0",
  "description": "无限画布设计工作台（天枢 TPI 插件）",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <27"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "verify": "npm run typecheck && npm run build && npm test",
    "verify:codegen": "node scripts/verify-codegen.mjs",
    "verify:codegen:real": "node scripts/verify-codegen-real.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "pack:plugin": "node scripts/pack-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xyflow/react": "^12.3.5",
    "esbuild": "^0.24.0",
    "json-canonicalize": "^1.2.0",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.6",
    "typescript": "^5.6.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
