{
  "schema": 1,
  "sharedClasses": ["ts-i-visually-hidden"],
  "note": "交互库：声明式标记 + 单一共享运行时。现有组件类（ts-tabs/ts-tab/ts-dialog/ts-toast/ts-switch/ts-progress/ts-table）被复用；交互库自有的结构/状态类统一用 ts-i- 前缀，避免与组件目录冲突。",
  "interactions": [
    {
      "id": "tabs",
      "name": "标签页",
      "category": "navigation",
      "classes": ["ts-i-tabs", "ts-tabs", "ts-tab", "ts-tab--active", "ts-i-tabs__panel"],
      "reused": ["ts-tabs", "ts-tab", "ts-tab--active"],
      "requiresScript": true,
      "rootAttr": "data-ts-tabs",
      "requiredStructure": ["<div class=\"ts-i-tabs\" data-ts-tabs>（外层容器，同时包住标签栏和面板）", "内层 <div class=\"ts-tabs\" role=\"tablist\"> 放标签", "每个面板 <div class=\"ts-i-tabs__panel\" data-ts-panel=\"<名字>\">"],
      "requiredAttrs": ["标签 data-ts-tab=\"名字\" 与面板 data-ts-panel=\"名字\" 对应"],
      "api": "点击 ts-tab 或按 ←→/Home/End 切换；自动维护 ts-tab--active、aria-selected、aria-controls、tabindex 与面板 hidden。",
      "skeletonHtml": "<div class=\"ts-i-tabs\" data-ts-tabs>\n  <div class=\"ts-tabs\" role=\"tablist\">\n    <button class=\"ts-tab ts-tab--active\" role=\"tab\" data-ts-tab=\"overview\" aria-selected=\"true\">概览</button>\n    <button class=\"ts-tab\" role=\"tab\" data-ts-tab=\"detail\" aria-selected=\"false\">明细</button>\n  </div>\n  <div class=\"ts-i-tabs__panel\" role=\"tabpanel\" data-ts-panel=\"overview\">概览内容</div>\n  <div class=\"ts-i-tabs__panel\" role=\"tabpanel\" data-ts-panel=\"detail\" hidden>明细内容</div>\n</div>"
    },
    {
      "id": "modal",
      "name": "模态弹窗",
      "category": "overlay",
      "classes": ["ts-dialog", "ts-dialog__header", "ts-dialog__title", "ts-dialog__body", "ts-dialog__footer", "ts-i-modal", "ts-i-modal--open", "ts-i-modal__scrim"],
      "reused": ["ts-dialog", "ts-dialog__header", "ts-dialog__title", "ts-dialog__body", "ts-dialog__footer"],
      "requiresScript": true,
      "rootAttr": "data-ts-modal",
      "requiredStructure": ["<div class=\"ts-i-modal\" data-ts-modal id=\"...\">", "内含 <div class=\"ts-i-modal__scrim\"> 与 <div class=\"ts-dialog\">"],
      "requiredAttrs": ["触发元素 data-ts-open=\"#模态 id\"；关闭元素 data-ts-close"],
      "api": "data-ts-open 打开、data-ts-close / 点遮罩 / Esc 关闭；打开时锁定焦点并在关闭后归还；自动维护 ts-i-modal--open 与 aria-hidden。",
      "skeletonHtml": "<button class=\"ts-btn ts-btn--primary\" data-ts-open=\"#dlg-demo\">打开</button>\n<div class=\"ts-i-modal\" id=\"dlg-demo\" data-ts-modal hidden>\n  <div class=\"ts-i-modal__scrim\" data-ts-close></div>\n  <div class=\"ts-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dlg-demo-title\">\n    <div class=\"ts-dialog__header\"><h3 class=\"ts-dialog__title\" id=\"dlg-demo-title\">确认</h3></div>\n    <div class=\"ts-dialog__body\">确定要执行吗？</div>\n    <div class=\"ts-dialog__footer\">\n      <button class=\"ts-btn ts-btn--secondary\" data-ts-close>取消</button>\n      <button class=\"ts-btn ts-btn--primary\" data-ts-close>确定</button>\n    </div>\n  </div>\n</div>"
    },
    {
      "id": "drawer",
      "name": "抽屉",
      "category": "overlay",
      "classes": ["ts-i-drawer", "ts-i-drawer--open", "ts-i-drawer__scrim", "ts-i-drawer__panel", "ts-i-drawer__header", "ts-i-drawer__title", "ts-i-drawer__body", "ts-i-drawer__footer"],
      "requiresScript": true,
      "rootAttr": "data-ts-drawer",
      "requiredStructure": ["<div class=\"ts-i-drawer\" data-ts-drawer id=\"...\" data-ts-side=\"right|left|top|bottom\">", "内含 ts-i-drawer__scrim 与 ts-i-drawer__panel"],
      "requiredAttrs": ["触发 data-ts-open=\"#抽屉 id\"；关闭 data-ts-close"],
      "api": "与 modal 同套开关协议；data-ts-side 决定滑出方向（默认 right）；Esc / 遮罩 / data-ts-close 关闭。",
      "skeletonHtml": "<button class=\"ts-btn ts-btn--secondary\" data-ts-open=\"#drawer-demo\">打开抽屉</button>\n<div class=\"ts-i-drawer\" id=\"drawer-demo\" data-ts-drawer data-ts-side=\"right\" hidden>\n  <div class=\"ts-i-drawer__scrim\" data-ts-close></div>\n  <aside class=\"ts-i-drawer__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawer-demo-title\">\n    <div class=\"ts-i-drawer__header\"><h3 class=\"ts-i-drawer__title\" id=\"drawer-demo-title\">筛选</h3><button class=\"ts-icon-btn\" data-ts-close aria-label=\"关闭\"><svg data-icon=\"x\" class=\"ts-icon\"></svg></button></div>\n    <div class=\"ts-i-drawer__body\">抽屉内容</div>\n    <div class=\"ts-i-drawer__footer\"><button class=\"ts-btn ts-btn--primary\" data-ts-close>完成</button></div>\n  </aside>\n</div>"
    },
    {
      "id": "dropdown",
      "name": "下拉菜单",
      "category": "navigation",
      "classes": ["ts-i-dropdown", "ts-i-dropdown--open", "ts-i-dropdown__trigger", "ts-i-dropdown__menu", "ts-i-dropdown__item", "ts-i-dropdown__item--danger"],
      "requiresScript": true,
      "rootAttr": "data-ts-dropdown",
      "requiredStructure": ["<div class=\"ts-i-dropdown\" data-ts-dropdown>", "内含 ts-i-dropdown__trigger（按钮）与 ts-i-dropdown__menu"],
      "requiredAttrs": ["菜单项用 ts-i-dropdown__item；trigger 需 aria-haspopup/aria-expanded"],
      "api": "点 trigger 或按 ↓ 打开；点外部 / Esc / 选中菜单项关闭；↑↓/Home/End 在菜单内移动焦点；自动维护 ts-i-dropdown--open 与 aria-expanded。",
      "skeletonHtml": "<div class=\"ts-i-dropdown\" data-ts-dropdown>\n  <button class=\"ts-btn ts-btn--secondary ts-i-dropdown__trigger\" aria-haspopup=\"menu\" aria-expanded=\"false\">操作</button>\n  <div class=\"ts-i-dropdown__menu\" role=\"menu\" hidden>\n    <button class=\"ts-i-dropdown__item\" role=\"menuitem\">编辑</button>\n    <button class=\"ts-i-dropdown__item\" role=\"menuitem\">复制</button>\n    <button class=\"ts-i-dropdown__item ts-i-dropdown__item--danger\" role=\"menuitem\">删除</button>\n  </div>\n</div>"
    },
    {
      "id": "accordion",
      "name": "折叠面板",
      "category": "navigation",
      "classes": ["ts-i-accordion", "ts-i-accordion__item", "ts-i-accordion__trigger", "ts-i-accordion__panel"],
      "requiresScript": false,
      "rootAttr": "data-ts-accordion",
      "requiredStructure": ["<div class=\"ts-i-accordion\" data-ts-accordion>", "每个条目 <details class=\"ts-i-accordion__item\"><summary class=\"ts-i-accordion__trigger\">…</summary><div class=\"ts-i-accordion__panel\">…</div></details>"],
      "requiredAttrs": ["无（默认多项可同时展开）"],
      "api": "基于原生 <details>/<summary>，无需脚本即可展开/折叠；加 data-ts-single 时由运行时保证同时只展开一项。",
      "skeletonHtml": "<div class=\"ts-i-accordion\" data-ts-accordion>\n  <details class=\"ts-i-accordion__item\" open>\n    <summary class=\"ts-i-accordion__trigger\">常见问题一</summary>\n    <div class=\"ts-i-accordion__panel\">答案一。</div>\n  </details>\n  <details class=\"ts-i-accordion__item\">\n    <summary class=\"ts-i-accordion__trigger\">常见问题二</summary>\n    <div class=\"ts-i-accordion__panel\">答案二。</div>\n  </details>\n</div>"
    },
    {
      "id": "toast",
      "name": "轻提示",
      "category": "feedback",
      "classes": ["ts-toast", "ts-toast--success", "ts-toast--danger", "ts-i-toast-region", "ts-i-toast-close"],
      "reused": ["ts-toast", "ts-toast--success", "ts-toast--danger"],
      "requiresScript": true,
      "rootAttr": "data-ts-toast-region",
      "requiredStructure": ["<div class=\"ts-i-toast-region\" data-ts-toast-region data-ts-position=\"top-right\">", "内含若干 <div class=\"ts-toast\">，可选 <button class=\"ts-i-toast-close\" data-ts-toast-dismiss>"],
      "requiredAttrs": ["自动消失用 data-ts-toast-duration=\"毫秒\"（默认 4000；0 表示不自动消失）"],
      "api": "区域内的 toast 到时长后自动淡出移除；点 data-ts-toast-dismiss 立即关闭。运行时另暴露 window.tsToast(text, variant) 追加一条（variant：''|success|danger）。",
      "skeletonHtml": "<div class=\"ts-i-toast-region\" data-ts-toast-region data-ts-position=\"top-right\" aria-live=\"polite\">\n  <div class=\"ts-toast ts-toast--success\" data-ts-toast-duration=\"4000\">已保存<button class=\"ts-i-toast-close\" data-ts-toast-dismiss aria-label=\"关闭\"><svg data-icon=\"x\" class=\"ts-icon\"></svg></button></div>\n</div>"
    },
    {
      "id": "tooltip",
      "name": "提示气泡",
      "category": "feedback",
      "classes": ["ts-i-tooltip", "ts-i-tooltip__bubble"],
      "requiresScript": false,
      "rootAttr": "data-ts-tooltip",
      "requiredStructure": ["<span class=\"ts-i-tooltip\" data-ts-tooltip=\"提示文字\">触发元素</span>"],
      "requiredAttrs": ["提示文字写在 data-ts-tooltip；方位用 data-ts-tooltip-side=\"top|bottom|left|right\"（默认 top）"],
      "api": "纯 CSS：hover 或键盘聚焦时显示气泡；气泡内容来自 data-ts-tooltip 的 ::after，无需脚本。",
      "skeletonHtml": "<span class=\"ts-i-tooltip\" data-ts-tooltip=\"这是提示文字\" data-ts-tooltip-side=\"top\"><svg data-icon=\"info\" class=\"ts-icon\"></svg></span>"
    },
    {
      "id": "loading-skeleton",
      "name": "骨架屏",
      "category": "feedback",
      "classes": ["ts-i-skeleton", "ts-i-skeleton--text", "ts-i-skeleton--circle", "ts-i-skeleton--card"],
      "requiresScript": false,
      "rootAttr": "data-ts-skeleton",
      "requiredStructure": ["<div class=\"ts-i-skeleton ts-i-skeleton--text\" data-ts-skeleton></div>"],
      "requiredAttrs": ["形状变体 ts-i-skeleton--text|circle|card；宽度用内联 style 或类控制"],
      "api": "纯 CSS 微光动画；容器加 aria-busy=\"true\" 表示加载中。",
      "skeletonHtml": "<div class=\"ts-stack\" data-ts-skeleton aria-busy=\"true\">\n  <div class=\"ts-i-skeleton ts-i-skeleton--circle\" style=\"width:40px;height:40px\"></div>\n  <div class=\"ts-i-skeleton ts-i-skeleton--text\" style=\"width:60%\"></div>\n  <div class=\"ts-i-skeleton ts-i-skeleton--card\" style=\"height:120px\"></div>\n</div>"
    },
    {
      "id": "progress",
      "name": "进度条",
      "category": "feedback",
      "classes": ["ts-progress", "ts-progress__bar", "ts-progress--indeterminate"],
      "reused": ["ts-progress", "ts-progress__bar"],
      "requiresScript": false,
      "rootAttr": "data-ts-progress",
      "requiredStructure": ["<div class=\"ts-progress\" data-ts-progress role=\"progressbar\" aria-valuenow=\"64\" aria-valuemin=\"0\" aria-valuemax=\"100\"><span class=\"ts-progress__bar\" style=\"width:64%\"></span></div>"],
      "requiredAttrs": ["确定值：ts-progress__bar 的 width + aria-valuenow；不确定：加 ts-progress--indeterminate（无需 width）"],
      "api": "确定进度直接给 bar 宽度；不确定进度用 ts-progress--indeterminate 走 CSS 动画。",
      "skeletonHtml": "<div class=\"ts-progress\" data-ts-progress role=\"progressbar\" aria-valuenow=\"64\" aria-valuemin=\"0\" aria-valuemax=\"100\"><span class=\"ts-progress__bar\" style=\"width:64%\"></span></div>\n<div class=\"ts-progress ts-progress--indeterminate\" data-ts-progress role=\"progressbar\" aria-label=\"加载中\"><span class=\"ts-progress__bar\"></span></div>"
    },
    {
      "id": "form-validation",
      "name": "表单校验",
      "category": "form",
      "classes": ["ts-i-form", "ts-i-form__field", "ts-i-form__error", "ts-i-form__error--show"],
      "requiresScript": true,
      "rootAttr": "data-ts-form",
      "requiredStructure": ["<form class=\"ts-i-form\" data-ts-form novalidate>", "每个字段容器 <div class=\"ts-i-form__field\"> 内含控件与 <p class=\"ts-i-form__error\"></p>"],
      "requiredAttrs": ["控件用原生 required/pattern/minlength/type=email 等；错误文案可写 data-ts-error=\"自定义文案\""],
      "api": "提交或控件失焦时用原生 checkValidity() 校验；无效字段显示 ts-i-form__error--show 并把第一条错误聚焦；全部通过时在表单上派发 ts:form-valid 事件（detail 为 FormData）。",
      "skeletonHtml": "<form class=\"ts-i-form ts-stack\" data-ts-form novalidate>\n  <div class=\"ts-i-form__field ts-field\">\n    <label class=\"ts-field__label\" for=\"f-email\">邮箱</label>\n    <input class=\"ts-input\" id=\"f-email\" name=\"email\" type=\"email\" required data-ts-error=\"请输入有效邮箱\" />\n    <p class=\"ts-i-form__error\" aria-live=\"polite\"></p>\n  </div>\n  <div class=\"ts-i-form__field ts-field\">\n    <label class=\"ts-field__label\" for=\"f-name\">姓名</label>\n    <input class=\"ts-input\" id=\"f-name\" name=\"name\" required minlength=\"2\" />\n    <p class=\"ts-i-form__error\" aria-live=\"polite\"></p>\n  </div>\n  <button class=\"ts-btn ts-btn--primary\" type=\"submit\">提交</button>\n</form>"
    },
    {
      "id": "segmented",
      "name": "分段控件",
      "category": "form",
      "classes": ["ts-i-segmented", "ts-i-segmented__item", "ts-i-segmented__item--active"],
      "requiresScript": true,
      "rootAttr": "data-ts-segmented",
      "requiredStructure": ["<div class=\"ts-i-segmented\" data-ts-segmented role=\"radiogroup\">", "每项 <button class=\"ts-i-segmented__item\" role=\"radio\" data-ts-value=\"…\">"],
      "requiredAttrs": ["role=radiogroup/radio 与 aria-checked；当前项加 ts-i-segmented__item--active"],
      "api": "单选：点击或 ←→ 移动选中；自动维护 aria-checked；切换时在根元素派发 ts:change 事件（detail 为选中的 data-ts-value）。",
      "skeletonHtml": "<div class=\"ts-i-segmented\" data-ts-segmented role=\"radiogroup\" aria-label=\"视图\">\n  <button class=\"ts-i-segmented__item ts-i-segmented__item--active\" role=\"radio\" aria-checked=\"true\" data-ts-value=\"day\">日</button>\n  <button class=\"ts-i-segmented__item\" role=\"radio\" aria-checked=\"false\" data-ts-value=\"week\">周</button>\n  <button class=\"ts-i-segmented__item\" role=\"radio\" aria-checked=\"false\" data-ts-value=\"month\">月</button>\n</div>"
    },
    {
      "id": "switch",
      "name": "开关",
      "category": "form",
      "classes": ["ts-switch", "ts-switch--on"],
      "reused": ["ts-switch", "ts-switch--on"],
      "requiresScript": true,
      "rootAttr": "data-ts-switch",
      "requiredStructure": ["<button class=\"ts-switch\" data-ts-switch role=\"switch\" aria-checked=\"false\"></button>"],
      "requiredAttrs": ["role=switch 与 aria-checked；开启态加 ts-switch--on 与 aria-checked=\"true\""],
      "api": "点击或 Space/Enter 切换；自动维护 ts-switch--on、aria-checked；切换时派发 ts:change（detail 为布尔值）。",
      "skeletonHtml": "<button class=\"ts-switch ts-switch--on\" data-ts-switch role=\"switch\" aria-checked=\"true\" aria-label=\"启用通知\"></button>"
    },
    {
      "id": "stepper",
      "name": "步骤条",
      "category": "form",
      "classes": ["ts-i-stepper", "ts-i-stepper__step", "ts-i-stepper__step--active", "ts-i-stepper__step--done", "ts-i-stepper__marker", "ts-i-stepper__label", "ts-i-stepper__line"],
      "requiresScript": true,
      "rootAttr": "data-ts-stepper",
      "requiredStructure": ["<div class=\"ts-i-stepper\" data-ts-stepper data-ts-current=\"1\">", "每步 <div class=\"ts-i-stepper__step\" data-ts-step=\"1\"><span class=\"ts-i-stepper__marker\">1</span><span class=\"ts-i-stepper__label\">…</span></div>，步骤间 <span class=\"ts-i-stepper__line\">"],
      "requiredAttrs": ["根元素 data-ts-current 指定当前步（从 1 起）；可选 data-ts-total=\"/总步数\""],
      "api": "按 data-ts-current 自动标注每步 done/active/未达；提供 window.tsStepper(el, n) 前进/回退。",
      "skeletonHtml": "<div class=\"ts-i-stepper\" data-ts-stepper data-ts-current=\"2\">\n  <div class=\"ts-i-stepper__step\" data-ts-step=\"1\"><span class=\"ts-i-stepper__marker\">1</span><span class=\"ts-i-stepper__label\">填写信息</span></div>\n  <span class=\"ts-i-stepper__line\"></span>\n  <div class=\"ts-i-stepper__step\" data-ts-step=\"2\"><span class=\"ts-i-stepper__marker\">2</span><span class=\"ts-i-stepper__label\">确认</span></div>\n  <span class=\"ts-i-stepper__line\"></span>\n  <div class=\"ts-i-stepper__step\" data-ts-step=\"3\"><span class=\"ts-i-stepper__marker\">3</span><span class=\"ts-i-stepper__label\">完成</span></div>\n</div>"
    },
    {
      "id": "pagination",
      "name": "分页",
      "category": "data",
      "classes": ["ts-i-pagination", "ts-i-pagination__item", "ts-i-pagination__item--active", "ts-i-pagination__prev", "ts-i-pagination__next"],
      "requiresScript": true,
      "rootAttr": "data-ts-pagination",
      "requiredStructure": ["<nav class=\"ts-i-pagination\" data-ts-pagination data-ts-total=\"12\" data-ts-page=\"1\">", "内含 ts-i-pagination__prev / 页码 / ts-i-pagination__next"],
      "requiredAttrs": ["data-ts-total 总页数、data-ts-page 当前页（从 1 起）"],
      "api": "点上一页/下一页/页码切换；自动维护 ts-i-pagination__item--active、aria-current 与 prev/next 禁用态；切换时派发 ts:change（detail 为新页码）。",
      "skeletonHtml": "<nav class=\"ts-i-pagination\" data-ts-pagination data-ts-total=\"5\" data-ts-page=\"1\" aria-label=\"分页\">\n  <button class=\"ts-i-pagination__prev\" data-ts-page-prev aria-label=\"上一页\"><svg data-icon=\"chevron-left\" class=\"ts-icon\"></svg></button>\n  <button class=\"ts-i-pagination__item ts-i-pagination__item--active\" aria-current=\"page\">1</button>\n  <button class=\"ts-i-pagination__item\">2</button>\n  <button class=\"ts-i-pagination__item\">3</button>\n  <button class=\"ts-i-pagination__next\" data-ts-page-next aria-label=\"下一页\"><svg data-icon=\"chevron-right\" class=\"ts-icon\"></svg></button>\n</nav>"
    },
    {
      "id": "sortable-table",
      "name": "可排序表格",
      "category": "data",
      "classes": ["ts-table", "ts-i-table--sortable", "ts-i-table__th--sortable", "ts-i-table__sort"],
      "reused": ["ts-table"],
      "requiresScript": true,
      "rootAttr": "data-ts-table",
      "requiredStructure": ["<table class=\"ts-table ts-i-table--sortable\" data-ts-table>", "需要排序的表头 <th class=\"ts-i-table__th--sortable\" data-ts-sort=\"number|text\" aria-sort=\"none\">，内可放 <span class=\"ts-i-table__sort\"></span>"],
      "requiredAttrs": ["data-ts-sort 指定比较方式（number/text）；单元格数值可加 data-ts-value 覆盖排序键"],
      "api": "点可排序表头在 升序/降序 间切换，DOM 重排 <tbody> 行并维护 aria-sort；纯前端排序（无后端）。",
      "skeletonHtml": "<table class=\"ts-table ts-i-table--sortable\" data-ts-table>\n  <thead><tr>\n    <th class=\"ts-i-table__th--sortable\" data-ts-sort=\"text\" aria-sort=\"none\" scope=\"col\">名称<span class=\"ts-i-table__sort\"></span></th>\n    <th class=\"ts-i-table__th--sortable ts-table__num\" data-ts-sort=\"number\" aria-sort=\"none\" scope=\"col\">数量<span class=\"ts-i-table__sort\"></span></th>\n  </tr></thead>\n  <tbody>\n    <tr><td>乙</td><td class=\"ts-table__num\" data-ts-value=\"12\">12</td></tr>\n    <tr><td>甲</td><td class=\"ts-table__num\" data-ts-value=\"7\">7</td></tr>\n  </tbody>\n</table>"
    },
    {
      "id": "date-picker",
      "name": "日期选择",
      "category": "data",
      "classes": ["ts-i-datepicker", "ts-i-datepicker__input", "ts-i-datepicker__popup", "ts-i-datepicker__nav", "ts-i-datepicker__grid", "ts-i-datepicker__day", "ts-i-datepicker__day--today", "ts-i-datepicker__day--selected"],
      "requiresScript": true,
      "rootAttr": "data-ts-datepicker",
      "requiredStructure": ["<div class=\"ts-i-datepicker\" data-ts-datepicker>", "内含 <input class=\"ts-input ts-i-datepicker__input\"> 与 <div class=\"ts-i-datepicker__popup\" hidden>（运行时生成网格）"],
      "requiredAttrs": ["输入框加 readonly 防手输；可给 data-ts-value=\"YYYY-MM-DD\" 设初值"],
      "api": "点输入框展开月历；←→↑↓ 移动、Enter 选中、Esc 关闭；自动维护 ts-i-datepicker__day--today/--selected 与输入框值，选中时派发 ts:change（detail 为 'YYYY-MM-DD'）。日历全部在内存计算，不依赖后端。",
      "skeletonHtml": "<div class=\"ts-i-datepicker\" data-ts-datepicker>\n  <input class=\"ts-input ts-i-datepicker__input\" readonly data-ts-value=\"2026-11-07\" aria-label=\"选择日期\" />\n  <div class=\"ts-i-datepicker__popup\" hidden></div>\n</div>"
    },
    {
      "id": "scroll-progress",
      "name": "滚动进度",
      "category": "navigation",
      "classes": ["ts-i-scroll-progress", "ts-i-scroll-progress--visible", "ts-i-scroll-progress__ring", "ts-i-scroll-progress__track", "ts-i-scroll-progress__value", "ts-i-scroll-progress__icon", "ts-i-scroll-progress__label"],
      "requiresScript": true,
      "rootAttr": "data-ts-scroll-progress",
      "requiredStructure": ["<div class=\"ts-i-scroll-progress\" data-ts-scroll-progress role=\"button\" tabindex=\"0\" aria-label=\"返回顶部\">", "内含 <svg class=\"ts-i-scroll-progress__ring\" viewBox=\"0 0 100 100\">（track + value 两个圆）与 <span class=\"ts-i-scroll-progress__label\">"],
      "requiredAttrs": ["data-ts-threshold：滚动多少像素后显形（默认 300）；data-ts-label：无障碍与提示文案（默认「返回顶部」）"],
      "api": "滚动时用 rAF 节流更新圆环（strokeDashoffset）与百分比文本；滚动超过阈值加 ts-i-scroll-progress--visible；点击或 Enter/Space 平滑回到顶部（尊重 prefers-reduced-motion）。",
      "skeletonHtml": "<div class=\"ts-i-scroll-progress\" data-ts-scroll-progress role=\"button\" tabindex=\"0\" aria-label=\"返回顶部\">\n  <svg class=\"ts-i-scroll-progress__ring\" viewBox=\"0 0 100 100\" aria-hidden=\"true\">\n    <circle class=\"ts-i-scroll-progress__track\" cx=\"50\" cy=\"50\" r=\"45\"></circle>\n    <circle class=\"ts-i-scroll-progress__value\" cx=\"50\" cy=\"50\" r=\"45\"></circle>\n  </svg>\n  <span class=\"ts-i-scroll-progress__icon\" aria-hidden=\"true\"><svg data-icon=\"arrow-up\" class=\"ts-icon\"></svg></span>\n  <span class=\"ts-i-scroll-progress__label\">0%</span>\n</div>"
    },
    {
      "id": "sticky-header",
      "name": "吸顶头部",
      "category": "navigation",
      "classes": ["ts-i-sticky-header", "ts-i-sticky-header--scrolled", "ts-i-sticky-header--hidden"],
      "requiresScript": true,
      "rootAttr": "data-ts-sticky",
      "requiredStructure": ["<header class=\"ts-i-sticky-header\" data-ts-sticky>…</header>（内层可放 ts-nav 组件）"],
      "requiredAttrs": ["data-ts-scroll-threshold：超过该滚动量加 --scrolled（默认 50）；data-ts-hide-threshold：超过该滚动量且向下滚时加 --hidden（默认 100）"],
      "api": "滚动时用 rAF 节流：超过 scroll-threshold 加 ts-i-sticky-header--scrolled；向下滚且超过 hide-threshold 加 ts-i-sticky-header--hidden，向上滚立即复现。收缩与上滑的具体外观由 token 与 CSS 决定，脚本只维护状态类。",
      "skeletonHtml": "<header class=\"ts-i-sticky-header\" data-ts-sticky>\n  <div class=\"ts-nav\">\n    <span class=\"ts-nav__brand\">品牌</span>\n    <nav class=\"ts-nav__links\">\n      <a class=\"ts-nav__link ts-nav__link--active\" href=\"#\">首页</a>\n      <a class=\"ts-nav__link\" href=\"#\">文档</a>\n    </nav>\n  </div>\n</header>"
    },
    {
      "id": "scroll-reveal",
      "name": "视口渐显",
      "category": "feedback",
      "classes": ["ts-i-reveal", "ts-i-reveal--armed", "ts-i-reveal--up", "ts-i-reveal--left", "ts-i-reveal--right", "ts-i-reveal--visible"],
      "requiresScript": true,
      "rootAttr": "data-ts-reveal",
      "requiredStructure": ["<div class=\"ts-i-reveal ts-i-reveal--up\" data-ts-reveal>…</div>", "可选父容器 data-ts-reveal-group 让子项依次入场"],
      "requiredAttrs": ["方向类 ts-i-reveal--up|left|right（默认 up）；data-ts-delay 毫秒延迟（可选）"],
      "api": "IntersectionObserver 进入视口即加 ts-i-reveal--visible（只触发一次），data-ts-delay 控制错峰。运行时先把根元素标记为 ts-i-reveal--armed 才启用初始位移，因此无脚本时内容照常可见，不会永久隐形。",
      "skeletonHtml": "<div class=\"ts-stack\" data-ts-reveal-group>\n  <div class=\"ts-card ts-i-reveal ts-i-reveal--up\" data-ts-reveal><div class=\"ts-card__body\">第一段内容</div></div>\n  <div class=\"ts-card ts-i-reveal ts-i-reveal--up\" data-ts-reveal><div class=\"ts-card__body\">第二段内容</div></div>\n</div>"
    },
    {
      "id": "tilt-card",
      "name": "倾斜卡片",
      "category": "feedback",
      "classes": ["ts-i-tilt", "ts-i-tilt--armed", "ts-i-tilt__inner"],
      "requiresScript": true,
      "rootAttr": "data-ts-tilt",
      "requiredStructure": ["<div class=\"ts-i-tilt\" data-ts-tilt><div class=\"ts-i-tilt__inner\">…</div></div>"],
      "requiredAttrs": ["data-ts-max-tilt：最大倾角（默认 12 度）；内容需包在 ts-i-tilt__inner 里才会跟随透视"],
      "api": "指针移动时按相对卡片中心的位置计算 rotateX/rotateY 透视，指针离开回正。仅对支持悬停与精细指针的设备启用（pointer: fine，运行时加 ts-i-tilt--armed）；触屏与键盘不受影响。",
      "skeletonHtml": "<div class=\"ts-i-tilt\" data-ts-tilt>\n  <div class=\"ts-i-tilt__inner\">\n    <div class=\"ts-card\"><div class=\"ts-card__body\">悬停查看立体效果</div></div>\n  </div>\n</div>"
    },
    {
      "id": "mobile-nav",
      "name": "移动端菜单",
      "category": "navigation",
      "classes": ["ts-i-mobile-nav", "ts-i-mobile-nav--open", "ts-i-mobile-nav--locked", "ts-i-mobile-nav__toggle", "ts-i-mobile-nav__bar", "ts-i-mobile-nav__backdrop"],
      "requiresScript": true,
      "rootAttr": "data-ts-mobile-nav",
      "requiredStructure": ["<nav class=\"ts-i-mobile-nav\" data-ts-mobile-nav>", "内含 <button class=\"ts-i-mobile-nav__toggle\">（三条 <span class=\"ts-i-mobile-nav__bar\">）、<div class=\"ts-i-mobile-nav__backdrop\"> 与承载链接的 <div class=\"ts-nav__links\">"],
      "requiredAttrs": ["toggle 需 aria-expanded/aria-controls/aria-label；被控面板需 id"],
      "api": "点 toggle 开合，自动维护 ts-i-mobile-nav--open 与 aria-expanded；点遮罩、Esc（焦点归还 toggle）或点菜单里的链接即关闭；打开时给 <html> 加 ts-i-mobile-nav--locked 锁滚动。宽屏下自动复位并隐藏 toggle。",
      "skeletonHtml": "<nav class=\"ts-i-mobile-nav\" data-ts-mobile-nav>\n  <button class=\"ts-i-mobile-nav__toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mnav-menu\" aria-label=\"打开导航菜单\">\n    <span class=\"ts-i-mobile-nav__bar\"></span><span class=\"ts-i-mobile-nav__bar\"></span><span class=\"ts-i-mobile-nav__bar\"></span>\n  </button>\n  <div class=\"ts-i-mobile-nav__backdrop\"></div>\n  <div class=\"ts-nav__links\" id=\"mnav-menu\">\n    <a class=\"ts-nav__link ts-nav__link--active\" href=\"#\">首页</a>\n    <a class=\"ts-nav__link\" href=\"#\">文档</a>\n  </div>\n</nav>"
    },
    {
      "id": "copy-code",
      "name": "代码复制",
      "category": "data",
      "classes": ["ts-i-copy", "ts-i-copy--done", "ts-i-copy__code", "ts-i-copy__btn"],
      "requiresScript": true,
      "rootAttr": "data-ts-copy",
      "requiredStructure": ["<div class=\"ts-i-copy\" data-ts-copy><pre class=\"ts-i-copy__code\">…</pre><button class=\"ts-i-copy__btn\" data-ts-copy-btn>…</button></div>"],
      "requiredAttrs": ["待复制文本取自 ts-i-copy__code 的文本内容；按钮写 data-ts-copy-btn；成功文案用 data-ts-copied-label=\"已复制\"（默认「已复制」）"],
      "api": "点按钮优先用 navigator.clipboard.writeText；不可用时（画布 iframe 是 opaque origin 沙箱，剪贴板 API 可能被拒）退回临时 textarea + execCommand。成功加 ts-i-copy--done 并把按钮文案换成 data-ts-copied-label，约 1600ms 后复原。",
      "skeletonHtml": "<div class=\"ts-i-copy\" data-ts-copy>\n  <pre class=\"ts-i-copy__code\">npm run build</pre>\n  <button class=\"ts-i-copy__btn\" data-ts-copy-btn data-ts-copied-label=\"已复制\" aria-label=\"复制代码\"><svg data-icon=\"copy\" class=\"ts-icon\"></svg></button>\n</div>"
    },
    {
      "id": "toc-outline",
      "name": "大纲侧栏",
      "category": "navigation",
      "classes": ["ts-i-toc", "ts-i-toc--open", "ts-i-toc__toggle", "ts-i-toc__backdrop", "ts-i-toc__panel", "ts-i-toc__title", "ts-i-toc__list", "ts-i-toc__link", "ts-i-toc__link--active"],
      "requiresScript": true,
      "rootAttr": "data-ts-toc",
      "requiredStructure": ["<aside class=\"ts-i-toc\" data-ts-toc>", "内含 ts-i-toc__toggle（按钮）、ts-i-toc__backdrop、ts-i-toc__panel（内含 ts-i-toc__title / ts-i-toc__list / ts-i-toc__link）"],
      "requiredAttrs": ["链接 href 指向页面内锚点（#小节 id）；toggle 需 aria-expanded/aria-controls/aria-label"],
      "api": "滚动时高亮当前小节（ts-i-toc__link--active + aria-current），只读取页面锚点位置，不发网络请求。窄屏可折叠：点 toggle 开合，点链接 / 遮罩 / Esc 关闭并把焦点归还 toggle。",
      "skeletonHtml": "<aside class=\"ts-i-toc\" data-ts-toc>\n  <button class=\"ts-i-toc__toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"toc-panel\" aria-label=\"打开目录\"><svg data-icon=\"list\" class=\"ts-icon\"></svg></button>\n  <div class=\"ts-i-toc__backdrop\"></div>\n  <nav class=\"ts-i-toc__panel\" id=\"toc-panel\" aria-label=\"目录\">\n    <p class=\"ts-i-toc__title\">目录</p>\n    <div class=\"ts-i-toc__list\">\n      <a class=\"ts-i-toc__link ts-i-toc__link--active\" href=\"#sec-1\">第一节</a>\n      <a class=\"ts-i-toc__link\" href=\"#sec-2\">第二节</a>\n    </div>\n  </nav>\n</aside>"
    }
  ]
}
