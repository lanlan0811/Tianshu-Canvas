      "display": "Aleo, ui-serif, Georgia, 'Songti SC', 'STSong', serif",
      "mono": "'Roboto Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 17,
      "xl": 21,
      "2xl": 26,
      "3xl": 34,
      "4xl": 48
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.45,
      "relaxed": 1.65
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.08em"
    }
