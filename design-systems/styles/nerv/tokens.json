{
  "schema": "tianshu-design-tokens/1",
  "id": "nerv",
  "version": 1,
  "modes": {
    "light": false,
    "dark": true
  },
  "color": {
    "primitives": {
      "neutral": {
        "0": "#ffffff",
        "50": "#0f0f10",
        "100": "#111112",
        "200": "#303136",
        "300": "#444650",
        "500": "#a3a7b0",
        "700": "#d0d4dc",
        "900": "#191b1e"
      },
      "brand": {
        "100": "#2a1618",
        "300": "#8c3339",
        "500": "#cc363b",
        "600": "#e04a4f",
        "700": "#ea343a"
      },
      "success": {
        "50": "#16281c",
        "500": "#7ee0a0"
      },
      "warning": {
        "50": "#33280f",
        "500": "#f0c060"
      },
      "danger": {
        "50": "#3a1d20",
        "500": "#ff8a8f"
      },
      "info": {
        "50": "#152436",
        "500": "#8ab8ff"
      }
    },
    "semantic": {
      "bg": {
        "canvas": "neutral.50",
        "surface": "neutral.100",
        "raised": "neutral.900",
        "sunken": "neutral.50",
        "inverse": "neutral.0"
      },
      "text": {
        "primary": "neutral.0",
        "secondary": "neutral.700",
        "muted": "neutral.500",
        "inverse": "neutral.50",
        "link": "brand.500"
      },
      "border": {
        "default": "neutral.200",
        "strong": "neutral.300",
        "subtle": "neutral.100",
        "focus": "brand.500"
      },
      "action": {
        "primary": "brand.500",
        "primaryHover": "brand.600",
        "primaryText": "neutral.0",
        "secondary": "neutral.900",
        "secondaryHover": "neutral.200",
        "secondaryText": "neutral.0",
        "ghostHover": "brand.100",
        "danger": "brand.700",
        "dangerText": "neutral.0"
      },
      "status": {
        "success": "success.500",
        "successBg": "success.50",
        "warning": "warning.500",
        "warningBg": "warning.50",
        "danger": "danger.500",
        "dangerBg": "danger.50",
        "info": "info.500",
        "infoBg": "info.50"
      },
      "chart": {
        "1": "#ea343a",
        "2": "#7c5cff",
        "3": "#8ab8ff",
        "4": "#e070ff",
        "5": "#8ef0ff"
      },
      "overlay": {
        "scrim": "rgba(0,0,0,0.6)"
      }
