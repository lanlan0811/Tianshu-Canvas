      "neutral": {
        "0": "#ffffff",
        "50": "#fffdf8",
        "100": "#faf7f0",
        "200": "#f3ede1",
        "300": "#d9cfbd",
        "500": "#8a8275",
        "700": "#4a453d",
        "900": "#2b2b2b"
      },
      "brand": {
        "100": "#f7e3d3",
        "300": "#eebfa4",
        "500": "#b8562a",
        "600": "#a64d24",
        "700": "#94431f"
      },
      "success": {
        "50": "#eefaf4",
        "500": "#1f7d5c"
      },
      "warning": {
        "50": "#fff7e3",
        "500": "#b8771a"
      },
      "danger": {
        "50": "#fbeceb",
