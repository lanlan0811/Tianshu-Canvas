{
  "schema": "tianshu-design-tokens/1",
  "id": "tianshu-original",
  "version": 2,
  "modes": {
    "light": true,
    "dark": false
  },
  "color": {
    "primitives": {
      "neutral": {
        "0": "#ffffff",
        "50": "#fafbf7",
        "100": "#f0f2ea",
        "200": "#e6e9df",
        "300": "#cdd3c4",
        "500": "#7a7566",
        "700": "#3f3d34",
        "900": "#1f2a26"
      },
      "brand": {
        "100": "#dcece7",
        "300": "#7cb3a7",
        "500": "#0f766e",
        "600": "#0b5a54",
        "700": "#0a4a45"
      },
      "success": {
        "50": "#e6f4ec",
        "500": "#1c6b4a"
      },
      "warning": {
        "50": "#f7efd9",
        "500": "#8a6410"
      },
      "danger": {
        "50": "#f9e7e4",
        "500": "#a52f24"
      },
      "info": {
        "50": "#e7eef1",
        "500": "#3a6272"
      }
    },
    "semantic": {
      "bg": {
        "canvas": "neutral.100",
        "surface": "neutral.50",
        "raised": "neutral.0",
        "sunken": "neutral.200",
        "inverse": "neutral.900"
      },
      "text": {
        "primary": "neutral.900",
        "secondary": "neutral.700",
        "muted": "neutral.500",
        "inverse": "neutral.50",
        "link": "brand.600"
      },
      "border": {
        "default": "neutral.200",
        "strong": "neutral.300",
        "subtle": "neutral.100",
        "focus": "brand.500"
      },
      "action": {
        "primary": "brand.500",
        "primaryHover": "brand.600",
        "primaryText": "neutral.0",
        "secondary": "neutral.50",
        "secondaryHover": "neutral.200",
        "secondaryText": "neutral.900",
        "ghostHover": "brand.100",
        "danger": "danger.500",
        "dangerText": "neutral.0"
      },
      "status": {
        "success": "success.500",
        "successBg": "success.50",
        "warning": "warning.500",
        "warningBg": "warning.50",
        "danger": "danger.500",
        "dangerBg": "danger.50",
        "info": "info.500",
        "infoBg": "info.50"
      },
      "chart": {
        "1": "#0f766e",
        "2": "#8a6410",
        "3": "#3a6272",
        "4": "#a52f24",
        "5": "#7cb3a7"
      },
      "overlay": {
        "scrim": "rgba(31,42,38,0.36)"
      }
    }
  },
  "font": {
    "families": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "display": "'Kaiti SC', 'STKaiti', KaiTi, '楷体', Georgia, serif",
      "mono": "ui-monospace, Menlo, Consolas, monospace"
    },
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 13,
      "lg": 15,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 40
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "snug": 1.35,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.08em"
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "borderWidth": {
    "hairline": 1,
    "thin": 1.5,
    "thick": 2
  },
  "shadow": {
    "sm": "0 1px 2px rgba(31,42,38,0.06)",
    "md": "0 4px 12px rgba(31,42,38,0.08)",
    "lg": "0 12px 28px rgba(31,42,38,0.10)"
  },
  "size": {
    "controlSm": 28,
    "controlMd": 34,
    "controlLg": 42,
    "iconSm": 14,
    "iconMd": 18,
    "iconLg": 22,
    "containerSm": 640,
    "containerMd": 960,
    "containerLg": 1200,
    "sidebar": 248
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "easing": "cubic-bezier(.2,.7,.3,1)"
  }
}
