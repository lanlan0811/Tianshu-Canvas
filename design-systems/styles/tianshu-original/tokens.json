        "secondaryText": "neutral.900",
        "ghostHover": "brand.100",
        "danger": "danger.500",
        "dangerText": "neutral.0"
      },
      "status": {
        "success": "success.500",
        "successBg": "success.50",
        "warning": "warning.500",
        "warningBg": "warning.50",
        "danger": "danger.500",
        "dangerBg": "danger.50",
        "info": "info.500",
        "infoBg": "info.50"
      },
      "chart": {
        "1": "#e07a3f",
        "2": "#6fd0ad",
        "3": "#6dbcf5",
