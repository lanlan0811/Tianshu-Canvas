      "mono": "ui-monospace, Menlo, Consolas, monospace"
    },
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 13,
      "lg": 15,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 40
