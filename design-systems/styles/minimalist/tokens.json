{
  "schema": "tianshu-design-tokens/1",
  "id": "minimalist",
  "version": 1,
  "modes": {
    "light": true,
    "dark": false
  },
  "color": {
    "primitives": {
      "neutral": {
        "0": "#ffffff",
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "300": "#d4d4d8",
        "500": "#71717a",
        "700": "#3f3f46",
        "900": "#18181b"
      },
      "brand": {
        "100": "#f4f4f5",
        "300": "#d4d4d8",
        "500": "#3f3f46",
        "600": "#27272a",
        "700": "#18181b"
      },
      "success": {
        "50": "#f0fdf4",
        "500": "#15803d"
      },
      "warning": {
        "50": "#fffbeb",
        "500": "#b45309"
      },
      "danger": {
        "50": "#fef2f2",
        "500": "#b91c1c"
      },
      "info": {
        "50": "#f0f9ff",
        "500": "#0369a1"
      }
    },
    "semantic": {
      "bg": {
        "canvas": "neutral.50",
        "surface": "neutral.0",
        "raised": "neutral.0",
        "sunken": "neutral.100",
        "inverse": "neutral.900"
      },
      "text": {
        "primary": "neutral.900",
        "secondary": "neutral.700",
        "muted": "neutral.500",
        "inverse": "neutral.0",
        "link": "brand.500"
      },
      "border": {
        "default": "neutral.200",
        "strong": "neutral.300",
        "subtle": "neutral.100",
        "focus": "neutral.900"
      },
      "action": {
        "primary": "neutral.900",
        "primaryHover": "brand.600",
        "primaryText": "neutral.0",
        "secondary": "neutral.100",
        "secondaryHover": "neutral.200",
        "secondaryText": "neutral.900",
        "ghostHover": "neutral.100",
        "danger": "danger.500",
        "dangerText": "neutral.0"
      },
      "status": {
        "success": "success.500",
        "successBg": "success.50",
        "warning": "warning.500",
        "warningBg": "warning.50",
        "danger": "danger.500",
        "dangerBg": "danger.50",
        "info": "info.500",
        "infoBg": "info.50"
      },
      "chart": {
        "1": "#d4d4d8",
        "2": "#a1a1aa",
        "3": "#71717a",
        "4": "#3f3f46",
        "5": "#18181b"
      },
      "overlay": {
        "scrim": "rgba(0,0,0,0.4)"
      }
    }
  },
  "font": {
    "families": {
      "sans": "Geist, ui-sans-serif, system-ui, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "display": "'DM Serif Display', ui-serif, Georgia, 'Songti SC', 'STSong', serif",
      "mono": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 17,
      "xl": 21,
      "2xl": 26,
      "3xl": 34,
      "4xl": 48
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.45,
      "relaxed": 1.65
    },
    "letterSpacing": {
      "tight": "-0.012em",
      "normal": "0",
      "wide": "0.06em"
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "sm": 6,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "full": 9999
  },
  "borderWidth": {
    "hairline": 1,
    "thin": 1.5,
    "thick": 2
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.05), 0 1px 1px rgba(0,0,0,0.03)",
    "md": "0 4px 8px -2px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04)",
    "lg": "0 12px 20px -6px rgba(0,0,0,0.08), 0 4px 8px -2px rgba(0,0,0,0.04)"
  },
  "size": {
    "controlSm": 28,
    "controlMd": 36,
    "controlLg": 44,
    "iconSm": 14,
    "iconMd": 18,
    "iconLg": 22,
    "containerSm": 640,
    "containerMd": 960,
    "containerLg": 1200,
    "sidebar": 248
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "easing": "cubic-bezier(.2,.7,.3,1)"
  }
}
